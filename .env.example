# ==============================================================================
# Environment Configuration for 3-EC2 Microservices Architecture
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or EC2 Instance 1 IP)
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/university_identity_db
# Example for EC2 Instance 1: mongodb://<EC2_1_PUBLIC_OR_PRIVATE_IP>:27017/university_identity_db
MONGO_URI=mongodb://127.0.0.1:27017/university_identity_db

# JWT Secret
JWT_SECRET=UniversitySecretKey2026

# EC2 Instance Public or Private IPs
EC2_1_IP=localhost
EC2_2_IP=localhost
EC2_3_IP=localhost

# Or specify full service endpoints directly:
# REGISTRATION_SERVICE=http://localhost:5001
# LOGIN_SERVICE=http://localhost:5002
# ADMIN_SERVICE=http://<EC2_2_IP>:5003
# USER_SERVICE=http://<EC2_3_IP>:5004
