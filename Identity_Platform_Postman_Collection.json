    {
      "name": "Task 5 - Registration Microservice",
      "item": [
        {
          "name": "1. Register Student/User Account (Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@university.edu\",\n  \"password\": \"alicePass123!\",\n  \"role\": \"user\",\n  \"phone\": \"+1-555-0199\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register/userregister",
              "host": ["{{baseUrl}}"],
              "path": ["register", "userregister"]
            },
            "description": "Registers a new user/student account with hashed password in MongoDB."
          },
          "response": []
        },
        {
          "name": "2. Register Admin Account (Success)",
